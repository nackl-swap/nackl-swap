# ---- Keys and secrets: never commit (test keys included: treat every key as real) ----
*.keys.json
*.key
*.pem
*.seed
*.phrase
*mnemonic*
.env
.env.*
!.env.example

# ---- Local machine config (contains local paths) ----
tvm-cli.conf.json
.claude/
.vscode/
.idea/

# ---- Build output (regenerated by the scripts: sold --tvm-version gosh) ----
build/
*.tvc
*.code
*.debug.json
*.abi.json
!tools/*.abi.json

# ---- Run logs (local paths, noisy; results are summarised in */RESULTS.md) ----
out/

# ---- OS / editor noise ----
.DS_Store
Thumbs.db
desktop.ini
*.swp
node_modules/
docs/MESSAGES_*.md
